{
  "name": "@commerce/plugin-seed-audio",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "commerce": {
    "manifestVersion": 1,
    "id": "official.seed-audio",
    "title": "Seed Audio 音频创作",
    "description": "基于 Seed Audio 1.0 模型创作人声、音效与音乐，支持场景化音频生成",
    "category": "音频创作",
    "api": "^1.2.0",
    "ui": "ui/index.html",
    "releaseNotes": "重新设计音频创作台，创作参数与试听并列展示，收紧圆角与间距，支持深色与窄屏。",
