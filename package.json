{
  "name": "@commerce/plugin-seed-audio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "commerce": {
    "manifestVersion": 1,
    "id": "official.seed-audio",
    "title": "Seed Audio 音频创作",
    "description": "基于 Seed Audio 1.0 模型创作人声、音效与音乐，支持场景化音频生成",
    "category": "音频创作",
    "api": "^1.2.0",
    "ui": "ui/index.html",
    "releaseNotes": "首版：接入 Seed Audio 1.0 音频创作模型，支持台词旁白、音效场景与背景音乐生成，提供采样率、语速与音高调节，音频在线试听与导出。",
    "permissions": {
      "files": true,
      "credentials": [
        "volcengine-ark-key"
      ],
      "network": [
        "https://openspeech.bytedance.com",
        "https://ark.cn-beijing.volces.com"
      ]
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "pack": "node scripts/pack-plugin.mjs"
  },
  "dependencies": {
    "@commerce/plugin-sdk": "file:vendor/commerce-plugin-sdk-1.2.0.tgz"
  },
  "license": "MIT"
}
